# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# IMPORTANTE: Sostituisci "user" e "password" con le tue credenziali PostgreSQL
#
# Per Windows:
# - Username predefinito: postgres
# - Password: quella che hai impostato durante l'installazione di PostgreSQL
# - Porta predefinita: 5432
# - Nome database: kanban_iso (deve essere creato prima di eseguire le migrazioni)
#
# Esempio:
# DATABASE_URL="postgresql://postgres:miapassword@localhost:5432/kanban_iso"
#
DATABASE_URL="postgresql://user:password@localhost:5432/kanban_iso"

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# Porta su cui il backend sarà in ascolto
PORT=5000

# Ambiente di esecuzione (development/production)
NODE_ENV=development

# ==============================================================================
# JWT (AUTHENTICATION)
# ==============================================================================
# Chiave segreta per firmare i token JWT
# ⚠️ IMPORTANTE: Cambia questa chiave in produzione con una stringa casuale lunga
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==============================================================================
# COMPANY NAME / LOGO (usato nei template email e UI)
# ==============================================================================
# Configurabili anche da Admin UI (/settings/email)
# COMPANY_NAME=Nome Azienda
# COMPANY_LOGO_URL=https://esempio.com/logo.png

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
# ⚠️ Le credenziali SMTP/IMAP (host, user, password) si configurano
#    dall'interfaccia admin: /settings/email
#    Le credenziali vengono salvate nel database, NON in questo file.
#
# Le variabili sotto sono opzionali e usate solo come fallback
# se il database non contiene ancora la configurazione email.
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=

# ==============================================================================
# FILE UPLOAD
# ==============================================================================
# Dimensione massima file (in bytes)
# 10485760 bytes = 10 MB
MAX_FILE_SIZE=10485760

# Directory per i file caricati (relativa alla cartella backend)
UPLOAD_DIR=../uploads

# ==============================================================================
# SLA DEFAULTS (in hours)
# ==============================================================================
# Tempo massimo per risolvere ticket in base alla priorità
#
# CRITICAL: 4 ore - Bug critici che bloccano il sistema
# HIGH: 24 ore - Bug importanti o richieste urgenti
# MEDIUM: 72 ore - Funzionalità normali
# LOW: 168 ore (7 giorni) - Miglioramenti non urgenti
#
SLA_CRITICAL=4
SLA_HIGH=24
SLA_MEDIUM=72
SLA_LOW=168

# ==============================================================================
# AI CONFIGURATION
# ==============================================================================
# L'AI supporta due provider (priorità: Groq → Anthropic)
#
# ── GROQ (GRATUITO) ────────────────────────────────────────────────────────────
# Registrati su https://console.groq.com → API Keys → Create API Key
# Piano gratuito: 14.400 richieste/giorno — più che sufficiente per uso aziendale
# Modello usato: llama-3.3-70b-versatile (molto capace)
#
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# ── ANTHROPIC CLAUDE (a pagamento, usato solo se GROQ_API_KEY non è impostata) ─
# Registrati su https://console.anthropic.com → API Keys
#
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
