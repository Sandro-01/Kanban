// Prisma Schema per Kanban ISO 9001/27001 Compliant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USER MANAGEMENT ============

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole @default(USER)
  department    String?
  status        UserStatus @default(ACTIVE)
  allowedPages  String[] @default([])
  avatarColor   String?  // Colore sfondo avatar (hex), assegnato alla creazione
  avatarUrl     String?  // Percorso relativo foto profilo, es. "avatars/userid-123.jpg"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  assignedTickets Ticket[] @relation("AssignedTickets")
  createdTickets  Ticket[] @relation("CreatedTickets")
  ticketAssignments TicketAssignment[] // Multi-assignment support
  comments        Comment[]
  attachments     Attachment[]
  auditLogs       AuditLog[]
  onboardings     Onboarding[] @relation("OnboardingUser")
  managedOnboardings Onboarding[] @relation("OnboardingManager")
  offboardings    Offboarding[] @relation("OffboardingUser")
  managedOffboardings Offboarding[] @relation("OffboardingManager")

  @@index([email])
  @@index([department])
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
  OFFBOARDING
  SUSPENDED
}

// ============ ONBOARDING / OFFBOARDING ============

model Onboarding {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation("OnboardingUser", fields: [userId], references: [id])
  managerId       String
  manager         User     @relation("OnboardingManager", fields: [managerId], references: [id])
  status          OnboardingStatus @default(PENDING_EQUIPMENT)
  startDate       DateTime @default(now())
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Informazioni nuovo dipendente (non ancora nel sistema)
  employeeFirstName String   // Nome del nuovo dipendente
  employeeLastName  String   // Cognome del nuovo dipendente
  employeeEmail     String   // Email del nuovo dipendente
  sede            String?
  department      String?
  role            String?  // Ruolo/Mansione

  // Dotazioni hardware
  computerType    String?  // "Portatile", "Desktop", "Non necessario"
  phoneType       String?  // "Fisso", "Android", "Non necessario"
  needsHeadset    Boolean  @default(false)
  needsWebcam     Boolean  @default(false)
  additionalMonitor Boolean @default(false)

  // Software e accessi
  needsMicrosoft365 Boolean @default(false)
  softwareNeeded    String?  // PackWay, HubSpot, ArtiosCAD, etc (testo libero)
  systemAccess      String?  // VPN, cartelle condivise, ERP, CRM (testo libero)

  // Note aggiuntive
  additionalNotes   String?

  tasks           OnboardingTask[]

  @@index([userId])
  @@index([status])
  @@index([department])
}

model OnboardingTask {
  id            String   @id @default(uuid())
  onboardingId  String
  onboarding    Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  title         String
  description   String
  order         Int
  completed     Boolean  @default(false)
  completedAt   DateTime?
  mandatory     Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([onboardingId])
}

enum OnboardingStatus {
  PENDING_EQUIPMENT  // HR ha creato, aspetta che responsabile aggiunga dotazioni
  IN_PROGRESS        // Dotazioni completate, onboarding in corso
  COMPLETED          // Onboarding completato
  CANCELLED          // Annullato
}

model Offboarding {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("OffboardingUser", fields: [userId], references: [id])
  managerId       String
  manager         User     @relation("OffboardingManager", fields: [managerId], references: [id])
  status          OffboardingStatus @default(IN_PROGRESS)
  startDate       DateTime @default(now())
  expectedEndDate DateTime
  actualEndDate   DateTime?
  reason          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks           OffboardingTask[]

  @@index([userId])
  @@index([status])
}

model OffboardingTask {
  id             String   @id @default(uuid())
  offboardingId  String
  offboarding    Offboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  title          String
  description    String
  order          Int
  completed      Boolean  @default(false)
  completedAt    DateTime?
  mandatory      Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([offboardingId])
}

enum OffboardingStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============ KANBAN TICKETS ============

model Board {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  columns     Column[]
  tickets     Ticket[]
}

model Column {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime @default(now())

  tickets   Ticket[]

  @@index([boardId])
}

model Ticket {
  id            String   @id @default(uuid())
  title         String
  description   String
  boardId       String
  board         Board    @relation(fields: [boardId], references: [id])
  columnId      String
  column        Column   @relation(fields: [columnId], references: [id])
  priority      Priority @default(MEDIUM)
  status        TicketStatus @default(OPEN)
  category      String?

  // User relations
  createdById   String
  createdBy     User     @relation("CreatedTickets", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    User?    @relation("AssignedTickets", fields: [assignedToId], references: [id])

  // Multi-assignment support
  assignedDepartments String[] @default([]) // Array of department names
  assignments    TicketAssignment[] // Multiple user assignments

  // SLA tracking
  slaHours      Int      @default(24)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  dueDate       DateTime
  resolvedAt    DateTime?
  slaViolated   Boolean  @default(false)

  // Email integration
  emailThreadId String?
  emailMessageId String?  // ID univoco del messaggio email per evitare duplicati
  externalContacts String[] @default([]) // Array of external email addresses (fornitori, clienti)

  // Relations
  comments      Comment[]
  attachments   Attachment[]
  history       TicketHistory[]

  @@index([boardId])
  @@index([columnId])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([emailMessageId])
}

// Many-to-many relation for multiple user assignments per ticket
model TicketAssignment {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())
  assignedBy  String   // ID of user who made the assignment

  @@unique([ticketId, userId]) // Prevent duplicate assignments
  @@index([ticketId])
  @@index([userId])
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

// ============ COMMENTS (IMMUTABLE) ============

model Comment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  // IMMUTABILE: Non può essere eliminato o modificato
  isDeleted Boolean  @default(false) // Soft delete solo per UI, ma dati rimangono

  // Email integration
  isEmailReply    Boolean  @default(false) // True se questo commento viene da email esterna
  isOutgoingEmail Boolean  @default(false) // True se è una email inviata a utente esterno
  fromEmail       String?  // Email del mittente esterno (se isEmailReply = true)
  toEmails        String[] @default([])    // Destinatari (se isOutgoingEmail = true)
  emailMessageId  String?  // ID univoco del messaggio email per evitare duplicati

  // Relation to attachments (files can be attached to a comment)
  attachments Attachment[]

  @@index([ticketId])
  @@index([userId])
  @@index([emailMessageId])
}

// ============ FILE ATTACHMENTS (IMMUTABLE) ============

model Attachment {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id])
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())
  uploadedAt  DateTime @default(now())

  // Inline email images (CID attachments embedded in HTML body)
  isInline    Boolean  @default(false)
  contentId   String?  // CID value, e.g. "image001.xyz@domain"

  // IMMUTABILE: Non può essere eliminato
  isDeleted   Boolean  @default(false) // Soft delete solo per UI, ma file rimane

  @@index([ticketId])
  @@index([commentId])
  @@index([uploadedById])
}

// ============ TICKET HISTORY (ISO COMPLIANCE) ============

model TicketHistory {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())
  changedBy String

  @@index([ticketId])
  @@index([changedAt])
}

// ============ AUDIT LOG (ISO 9001/27001) ============

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  changes     Json?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  // ISO Compliance: categorization
  isoStandard String[] // ["ISO9001", "ISO27001"]
  severity    AuditSeverity @default(INFO)

  @@index([userId])
  @@index([timestamp])
  @@index([entity, entityId])
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

// ============ SLA CONFIGURATION ============

model SLAConfig {
  id          String   @id @default(uuid())
  category    String   @unique
  priority    Priority
  hours       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([priority])
}

// ============ EMAIL LOGS ============

model EmailLog {
  id          String   @id @default(uuid())
  ticketId    String?
  to          String
  from        String
  subject     String
  body        String
  status      EmailStatus @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  error       String?

  @@index([ticketId])
  @@index([status])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// ============ SYSTEM CONFIGURATION ============

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String   @id @default(uuid())
  userId    String   // Destinatario
  type      String   // COMMENT, ASSIGNMENT, STATUS_CHANGE, SLA_ALERT, EMAIL, AI_SUGGESTION
  title     String
  message   String
  ticketId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ============ KNOWLEDGE BASE ============

model KBArticle {
  id          String   @id @default(uuid())
  title       String
  content     String   // HTML content
  category    String
  tags        String[] @default([])
  authorId    String
  published   Boolean  @default(true)
  viewCount   Int      @default(0)
  helpfulCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([published])
}
